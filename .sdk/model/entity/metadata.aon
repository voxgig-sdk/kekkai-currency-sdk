# Entity: metadata

main: kit: entity: metadata: {

  alias: field: {}

  fields: [
    {
      name: "dataSources"
      req: false
      short: "List of data sources used by the API"
      type: "`$ARRAY`"
    }
    {
      format: "date-time"
      name: "lastUpdate"
      req: false
      short: "Timestamp of last data update"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "System status"
      type: "`$STRING`"
    }
    {
      name: "supportedCurrencies"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "version"
      req: false
      short: "API version"
      type: "`$STRING`"
    }
  ]

  name: "metadata"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/api/metadata"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "metadata"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
