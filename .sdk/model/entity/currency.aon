# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "date"
      req: false
      short: "Date and time of the rate"
      type: "`$STRING`"
    }
    {
      name: "from"
      req: false
      short: "Source currency code"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "rate"
      req: false
      short: "Exchange rate"
      type: "`$NUMBER`"
    }
    {
      name: "to"
      req: false
      short: "Target currency code"
      type: "`$STRING`"
    }
  ]

  name: "currency"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "2024-01-15"
                kind: "query"
                name: "date"
                orig: "date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "USD"
                kind: "query"
                name: "from"
                orig: "from"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "EUR"
                kind: "query"
                name: "to"
                orig: "to"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/getRate"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "getRate"
            }
          ]
          select: {
            exist: [
              "date"
              "from"
              "to"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
