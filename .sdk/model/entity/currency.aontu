# Entity: currency

main: kit: entity: currency: {

  alias: field: {}

  fields: {
    date: {
      fo: "date-time"
      h: "Date"
      n: "date"
      r: false
      sh: "Date and time of the rate"
      t: "`$STRING`"
    }
    from: {
      h: "From"
      n: "from"
      r: false
      sh: "Source currency code"
      t: "`$STRING`"
    }
    rate: {
      fo: "double"
      h: "Rate"
      n: "rate"
      r: false
      sh: "Exchange rate"
      t: "`$NUMBER`"
    }
    to: {
      h: "To"
      n: "to"
      r: false
      sh: "Target currency code"
      t: "`$STRING`"
    }
  }

  name: "currency"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /api/getRate"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "2024-01-15"
                k: "query"
                n: "date"
                or: "date"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "USD"
                k: "query"
                n: "from"
                or: "from"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "EUR"
                k: "query"
                n: "to"
                or: "to"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/getRate"
          q: {
            exist: [
              "date"
              "from"
              "to"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "getRate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
